<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tfg.TaskWindow.TaskClass">

    <children>

        <!-- TOP BAR: Title, Category, Date -->
        <HBox spacing="10"
              AnchorPane.topAnchor="10"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10">

            <TextField fx:id="taskTitle"
                       promptText="Enter the title of the task"
                       onAction="#searchByTitle"
                       HBox.hgrow="ALWAYS"/>

            <ComboBox fx:id="taskCategory"
                      promptText="Category"
                      onMousePressed="#searchByCategory"/>

            <DatePicker fx:id="taskDate"
                        promptText="Pick a date"
                        onAction="#searchByDate"/>
        </HBox>


        <!-- MAIN CONTENT AREA -->
        <HBox spacing="10"
              AnchorPane.topAnchor="50"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10"
              AnchorPane.bottomAnchor="60">

            <!-- LEFT SIDE: Task content -->
            <VBox spacing="10" prefWidth="180">
                <TextArea fx:id="taskContent"
                          promptText="What do you have to do?"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"/>

                <HBox spacing="10">
                    <Button fx:id="addTask" text="Add task" onAction="#addTask"/>
                    <Button fx:id="editTask" text="Edit task" onAction="#editTask"/>
                </HBox>

                <HBox spacing="10">
                    <Button fx:id="saveTask" text="Save task" onAction="#saveTask"/>
                    <Button fx:id="deleteTask" text="Delete task" onAction="#deleteTask"/>
                </HBox>

                <HBox spacing="10">
                    <Button fx:id="completeTask" text="Complete task" onAction="#completeTask"/>
                </HBox>
            </VBox>

            <!-- RIGHT SIDE: Table -->
            <TableView fx:id="taskTable" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tableDate" text="Date"/>
                    <TableColumn fx:id="tableTitle" text="Title"/>
                    <TableColumn fx:id="tableContent" text="Content"/>
                    <TableColumn fx:id="tableCategory" text="Category"/>
                    <TableColumn fx:id="tableCompleted" text="Completed"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </HBox>


        <!-- BOTTOM BAR -->
        <HBox spacing="10"
              AnchorPane.bottomAnchor="10"
              AnchorPane.leftAnchor="10"
              AnchorPane.rightAnchor="10">

            <Label fx:id="infoLabel">
                <font><Font size="10"/></font>
            </Label>

            <CheckBox fx:id="notificationCheckbox"
                      text="Automatic notifications"
                      onAction="#automaticNotification"/>

            <Pane HBox.hgrow="ALWAYS"/> <!-- spacer -->

            <Button fx:id="notifyTask" text="Notify by mail" onAction="#notifyTask"/>
            <Button fx:id="docs" text="Docs" onAction="#switchDocs"/>
            <Button fx:id="logout" text="Log out" onAction="#logout"/>

        </HBox>

    </children>
</AnchorPane>