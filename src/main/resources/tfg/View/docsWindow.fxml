<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.web.WebView?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tfg.DocsWindow.DocsWindow">

    <children>

        <!-- WebView fills all available space -->
        <WebView fx:id="web" AnchorPane.bottomAnchor="40" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" />

        <!-- Button stays at the bottom and stretches horizontally -->
        <Button fx:id="returnBtn" onAction="#returnToTask" prefHeight="40" styleClass="buttons" stylesheets="@../../CSS/styles.css" text="Return to task page" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" />

    </children>
</AnchorPane>
